   "outputs": [],
   "source": [
    "with open(\"map-characters.yaml\", \"w\") as f:\n",
    "    for i in range(0, 63):\n",
    "        binary = get_class_label(i)\n",
    "        f.write(f\"{i}: '{binary}'\\n\")"
   ]
  }
